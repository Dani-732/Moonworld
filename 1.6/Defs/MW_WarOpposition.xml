<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <DutyDef>
    <defName>MW_EnemyServantAssault</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="MoonWorld.JobGiver_EnemyServantAssault">
          <targetAcquireRadius>65</targetAcquireRadius>
          <targetKeepRadius>72</targetKeepRadius>
        </li>
        <li Class="JobGiver_AITrashColonyClose" />
        <li Class="JobGiver_AITrashBuildingsDistant" />
        <li Class="JobGiver_AIGotoNearestHostile" />
        <li Class="JobGiver_AITrashBuildingsDistant"><attackAllInert>true</attackAllInert></li>
        <li Class="JobGiver_AISapper"><canMineNonMineables>false</canMineNonMineables></li>
      </subNodes>
    </thinkNode>
  </DutyDef>
  <FactionDef Name="MW_WarOpposition" ParentName="FactionBase">
    <defName>MW_WarOpposition</defName>
    <label>圣杯战争敌对参战方</label>
    <fixedName>圣杯战争敌对参战方</fixedName>
    <description>响应本届圣杯呼唤的敌对御主与从者。</description>
    <pawnSingular>参战者</pawnSingular>
    <pawnsPlural>参战者</pawnsPlural>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <autoFlee>false</autoFlee>
    <techLevel>Industrial</techLevel>
    <startingCountAtWorldCreation>0</startingCountAtWorldCreation>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <canMakeRandomly>false</canMakeRandomly>
    <canGenerateQuestSites>false</canGenerateQuestSites>
    <raidsForbidden>true</raidsForbidden>
    <backstoryFilters><li><categories><li>Outlander</li></categories></li></backstoryFilters>
  </FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Saber</defName><label>圣杯战争 Saber 阵营</label><fixedName>圣杯战争 Saber 阵营</fixedName></FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Archer</defName><label>圣杯战争 Archer 阵营</label><fixedName>圣杯战争 Archer 阵营</fixedName></FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Lancer</defName><label>圣杯战争 Lancer 阵营</label><fixedName>圣杯战争 Lancer 阵营</fixedName></FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Assassin</defName><label>圣杯战争 Assassin 阵营</label><fixedName>圣杯战争 Assassin 阵营</fixedName></FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Caster</defName><label>圣杯战争 Caster 阵营</label><fixedName>圣杯战争 Caster 阵营</fixedName></FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Rider</defName><label>圣杯战争 Rider 阵营</label><fixedName>圣杯战争 Rider 阵营</fixedName></FactionDef>
  <FactionDef ParentName="MW_WarOpposition"><defName>MW_WarOpposition_Berserker</defName><label>圣杯战争 Berserker 阵营</label><fixedName>圣杯战争 Berserker 阵营</fixedName></FactionDef>
  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>MW_EnemyMaster</defName>
    <label>敌方御主</label>
    <race>Human</race>
    <defaultFactionDef>MW_WarOpposition</defaultFactionDef>
    <combatPower>60</combatPower>
    <isFighter>true</isFighter>
    <initialResistanceRange>0~0</initialResistanceRange>
    <minGenerationAge>20</minGenerationAge>
    <maxGenerationAge>50</maxGenerationAge>
    <weaponMoney>200~300</weaponMoney>
    <weaponTags><li>Gun</li></weaponTags>
    <apparelMoney>200~300</apparelMoney>
  </PawnKindDef>
</Defs>
